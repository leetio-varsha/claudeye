{
  "name": "claudeye",
  "version": "1.0.0",
  "description": "Production-ready personal memory for Claude Code",
  "type": "module",
  "bin": {
    "claudeye": "./cli.js"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "install-hooks": "node scripts/install-hooks.js",
    "viewer": "node src/server.js",
    "migrate": "node -e \"import('./src/db.js').then(m => m.migrate())\""
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "express": "^4.18.2",
    "ora": "^8.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
